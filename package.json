{
  "name": "365-micro-garage-companion",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first 365 Motor Sales companion idle racing clicker with a Phaser side-scroll racer and ghost race mode.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:race-progress": "node tests/raceProgress.test.mjs",
    "test:ghost-model": "node tests/ghostModel.test.mjs",
    "test:ghost-race": "node tests/ghostRace.test.mjs",
    "test:first-session-guide": "node tests/firstSessionGuide.test.mjs",
    "test:assets": "node tests/assetPaths.test.mjs",
    "test:v10": "npm run test:race-progress && npm run test:ghost-model && npm run test:ghost-race && npm run test:first-session-guide && npm run test:assets"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "canvas-confetti": "1.9.4",
    "gsap": "3.15.0",
    "lucide-static": "1.17.0",
    "phaser": "4.1.0",
    "pixi.js": "8.19.0",
    "screenfull": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "playwright": "^1.61.0",
    "vite": "8.0.16",
    "vite-plugin-pwa": "1.3.0"
  }
}
